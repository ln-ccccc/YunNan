# 发布演练用的环境文件模板。复制一份到仓库之外、换成临时口令后使用；真实口令不要提交。
# 第二个环境文件照常用仓库里的 image_bundle.env（镜像引用，不含口令）。
MYSQL_PASSWORD=换成演练临时口令
MYSQL_ROOT_PASSWORD=换成演练临时口令
ADMIN_USERNAME=admin
ADMIN_PASSWORD=换成演练临时口令
SECRET_KEY=换成至少32位的演练临时字符串

# 演练数据目录（宿主机路径，正斜杠）。存储目录必须是空的临时目录，绝不能指向生产的 project_storage
REHEARSAL_STORAGE=D:/yunnan-rehearsal/storage
# 离线底图只读挂入，给 GeoView 显示背景用；可以换成任意空目录
REHEARSAL_MAPS=D:/项目/YunNan/maps/dali
# 存放 yunnan.kml 与四个 xlsx 的项目目录（通常是开发主树），只读挂入
REHEARSAL_DATA_DIR=D:/项目/YunNan

# 演练用的 config.yaml：由发布目录那一份只改 4 个端口生成，命令是
#   python deploy/release_tool.py rehearsal-config <发布目录> <输出文件>
REHEARSAL_CONFIG=D:/yunnan-rehearsal/config.rehearsal.yaml

# Miner 界面在浏览器里取瓦片的地址（构建时写入产物），要指回演练的适配层端口
MINER_LOCAL_TILE_URL=http://127.0.0.1:28000/tiles/{z}/{x}/{y}.png

# 端口只绑 127.0.0.1 的高位端口，避开生产的 5008 / 3000 / 8000 / 4000
REHEARSAL_BACKEND_PORT=25008
REHEARSAL_FRONTEND_PORT=23000
REHEARSAL_MINER_API_PORT=28000
REHEARSAL_MINER_WEB_PORT=24000
